{% set page_first = {'page': '1'} %}
{% set page_prev = {'page': pagination.previous} %}
{% set page_prev2 = {'page': pagination.previous2} %}
{% set page_next = {'page': pagination.next} %}
{% set page_next2 = {'page': pagination.next2} %}
{% set page_last = {'page': pagination.total_pages} %}


{% if pagination.subdivision is defined %}
	{% set subdivision_params = { 'subdivision': pagination.subdivision } %}
	{% set page_first = page_first|merge(subdivision_params) %}
	{% set page_prev = page_prev|merge(subdivision_params) %}
	{% set page_prev2 = page_prev2|merge(subdivision_params) %}
	{% set page_next = page_next|merge(subdivision_params) %}
	{% set page_next2 = page_next2|merge(subdivision_params) %}
	{% set page_last = page_last|merge(subdivision_params) %}
{% endif %}

{% if pagination.subdivision_child is defined %}
	{% set subdivision_child_params = { 'subdivision_child': pagination.subdivision_child } %}
	{% set page_first = page_first|merge(subdivision_child_params) %}
	{% set page_prev = page_prev|merge(subdivision_child_params) %}
	{% set page_prev2 = page_prev2|merge(subdivision_child_params) %}
	{% set page_next = page_next|merge(subdivision_child_params) %}
	{% set page_next2 = page_next2|merge(subdivision_child_params) %}
	{% set page_last = page_last|merge(subdivision_child_params) %}
{% endif %}

{% if pagination.subdivision_child2 is defined %}
	{% set subdivision_child2_params = { 'subdivision_child2': pagination.subdivision_child2 } %}
	{% set page_first = page_first|merge(subdivision_child2_params) %}
	{% set page_prev = page_prev|merge(subdivision_child2_params) %}
	{% set page_prev2 = page_prev2|merge(subdivision_child2_params) %}
	{% set page_next = page_next|merge(subdivision_child2_params) %}
	{% set page_next2 = page_next2|merge(subdivision_child2_params) %}
	{% set page_last = page_last|merge(subdivision_child2_params) %}
{% endif %}

<section class="news-collection__big-title">
	<div class="container">
	    <div class="title__big title__big_left">
            <div class="title__slogan title__slogan_left">
                <svg class="title__svg">
					<use xlink:href="/themes/custom/ssu/assets/img/title/title-sprite.svg#big-title-left"></use>
                </svg>
                <div class="title__text title__text_left">
                    Узнавайте о жизни университетского сообщества «ВКонтакте» и «Одноклассниках», следите за новостями в «Телеграме», читайте лонгриды в «Дзене», смотрите сюжеты на «Rutube»
                </div>
            </div>
            <svg class="title__svg_center">
				<use xlink:href="/themes/custom/ssu/assets/img/title/title-sprite.svg#big-title-center"></use>
			</svg>
			<h2 class="title__header">Новости</h2>
        </div>
	</div>
</section>

<section class="news-collection__pagination">
	<div class="container">
		<div class="news-collection__pagination-wrapper">
			<div class="news-collection__pagination-one">

				{% if (pagination.total_pages != 1) %}
					{% if(pagination.current_page == 1)%}
						<span class="news-collection__number-page _current">1</span>
					{% else %}
						<a href="{{ path('news_subdivision_child.listing2', page_first) }}" class="news-collection__number-page _active">1</a>
					{% endif %}

					{% if (pagination.total_pages > 3) %}
						<span class="news-collection__number-page">...</span>
					{% endif %}

					{% if(pagination.display_previous_2 and pagination.display_previous_2 > 1)%}
						<a href="{{ path('news_subdivision_child.listing2', page_prev2) }}" class="news-collection__number-page lala _active">
							{{pagination.previous2}}
						</a>
					{% endif %}

					{% if(pagination.display_previous and pagination.current_page != 2)%}
						<a href="{{ path('news_subdivision_child.listing2', page_prev) }}" class="news-collection__number-page _active">
							{{pagination.previous}}
						</a>
					{% endif %}
					

					{% if(pagination.current_page > 1 and pagination.current_page != pagination.total_pages)%}
						<span class="news-collection__number-page _current">
							{{ pagination.current_page }} 
						</span>
					{% endif %}

					{% if(pagination.display_next and pagination.current_page + 1 != pagination.total_pages)%}
						<a href="{{ path('news_subdivision_child.listing2', page_next) }}" class="news-collection__number-page _active">
							{{pagination.next}}
						</a>
					{% endif %}

					{% if(pagination.display_next_2)%}
						<a href="{{ path('news_subdivision_child.listing2', page_next2) }}" class="news-collection__number-page _active">
							{{pagination.next2}}
						</a>
					{% endif %}

					{% if (pagination.total_pages > 3) %}
						<span class="news-collection__number-page">...</span>
					{% endif %}

					{% if(pagination.current_page < pagination.total_pages) %}
						<a href="{{ path('news_subdivision_child.listing2', page_last) }}" class="news-collection__number-page _active">
							{{ pagination.total_pages }}
						</a>
					{% else %}
						<span class="news-collection__number-page _current">{{ pagination.total_pages }}</span>
					{% endif %}
				{% endif %}
			</div>

			<div class="news-collection__pagination-two">

				<div class="news-collection__pagination-info">
					<span class="news-collection__pagination-text">страница</span>
					<input class="news-collection__pagination-input" name="numberpage" type="number" min="1" value="{{pagination.current_page}}" max="{{pagination.total_pages}}">
					<span class="news-collection__pagination-text">из</span>
					<span class="news-collection__pagination-text">{{ pagination.total_pages }}</span>
				</div>

				<div class="news-collection__pagination-arrow">
					<a href="{{ path('news_subdivision_child.listing2', page_prev) }}" class="news-collection__pagination-arrow-prev{{ pagination.current_page == 1 ? " disable" : ""}}"></a>
					<a href="{{ path('news_subdivision_child.listing2', page_next) }}" class="news-collection__pagination-arrow-next{{ pagination.total_pages == pagination.current_page ? " disable" : "" }}"></a>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="news-collection">
    <div class="container">
        <div class="news-collection__grid">
			{% if content.news is not empty %}
				{% for news in content.news %}
					{{ news }}
				{% endfor %}
			{% endif %}
        </div>
    </div>
</div>

